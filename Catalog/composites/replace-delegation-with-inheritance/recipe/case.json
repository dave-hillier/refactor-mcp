    { "refactoring": "replace-field-uses-with-base", "target": { "symbol": "T:Staff.Employee" }, "arguments": { "field": "_person" } },
    { "refactoring": "remove-delegating-member", "target": { "symbol": "P:Staff.Employee.Name" } },
    { "refactoring": "remove-delegating-member", "target": { "symbol": "M:Staff.Employee.LastName" } }
  ]
}
